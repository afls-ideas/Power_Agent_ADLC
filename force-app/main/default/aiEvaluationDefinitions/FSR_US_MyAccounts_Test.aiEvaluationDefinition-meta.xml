<AiEvaluationDefinition xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Verify the my_accounts topic routes correctly and invokes the rich accounts action.</description>
    <name>FSR_US_MyAccounts_Test</name>
    <subjectName>Field_Sales_HCP_Agent_US</subjectName>
    <subjectType>AGENT</subjectType>
    <testCase>
        <expectation>
